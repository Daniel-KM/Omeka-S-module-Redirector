#: data/scripts/upgrade.php:43
msgid "Missing requirement. Unable to upgrade."
msgstr "Prérequis manquant. Mise à jour impossible."

#: Module.php:51
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr ""
"Le module « %1$s » doit être mis à niveau à la version « %2$s » ou "
"supérieure."

#: data/scripts/upgrade.php:48
msgid "It is now possible to manage complex redirections with placeholders."
msgstr ""
"Il est désormais possible de gérer des redirections complexes avec des "
"jokers."

#: data/scripts/upgrade.php:58
msgid ""
"It is now possible to redirect a resource to another one, for example \"123 "
"= 456\"."
msgstr ""
"Il est désormais possible de rediriger une ressource vers une autre, par "
"exemple « 123 = 456 »."

#: data/scripts/upgrade.php:62
msgid "The redirections now support Omeka installed in a sub-directory."
msgstr ""
"Les redirections prennent désormais en charge Omeka installé dans un sous-"
"dossier."

#: data/scripts/upgrade.php:69
msgid ""
"The redirections can be set in the main settings too, for all sites and for "
"the pages outside of the sites."
msgstr ""
"Les redirections peuvent aussi être définies dans les paramètres généraux, "
"pour tous les sites et pour les pages hors des sites."

#: src/Mvc/MvcListeners.php:122
msgid "[Redirector] Rights check failed for resource {resource_id}: {message}"
msgstr ""
"[Redirecteur] La vérification des droits a échoué pour la ressource "
"{resource_id} : {message}"

#: src/Mvc/MvcListeners.php:224
msgid ""
"[Redirector] Page redirect failed for site \"{site_slug}\", page "
"\"{page_slug}\": {message}"
msgstr ""
"[Redirecteur] La redirection de la page a échoué pour le site {site_slug}, "
"page {page_slug} : {message}"

#: src/Mvc/MvcListeners.php:279
msgid "[Redirector] Redirect to resource {resource_id} failed: {message}"
msgstr ""
"[Redirecteur] La redirection vers la ressource {resource_id} a échoué : "
"{message}"

#: src/Mvc/MvcListeners.php:380
msgid "[Redirector] External redirect to {url} with status {status}."
msgstr "[Redirector] Redirection externe vers {url} avec le statut {status}."

#: src/Form/SettingsFieldset.php:15 src/Form/SettingsFieldset.php:21
msgid "Redirector"
msgstr "Redirecteur"

#: src/Form/SettingsFieldset.php:35
msgid ""
"Simple redirections from any resource (id = resource id, page slug or url)"
msgstr ""
"Redirections simples des ressources (id = id de ressource, chemin de la page "
"ou url)"

#: src/Form/SettingsFieldset.php:36
msgid ""
"Format: left part is a resource id; right part is another resource id, a "
"page slug or an absolute/relative url."
msgstr ""
"Format : la partie gauche est l’id de la ressource ; la partie droite est "
"l’id d’une autre ressource, le chemin de la page ou l’url relative ou "
"absolue."

#: src/Form/SettingsFieldset.php:40
msgid "Redirection"
msgstr "Redirection"

#: src/Form/SettingsFieldset.php:60
msgid "Advanced redirections (JSON)"
msgstr "Redirections avancées (json)"

#: src/Form/SettingsFieldset.php:61
msgid ""
"JSON: route or key => { \"target\": \"...\", \"route\": \"site/page\", "
"\"params\": {...}, \"query\": {...}, \"status\": 302 }. Redirect is internal "
"when status is not set."
msgstr ""
"Json : route ou clé => { \"target\": \"...\", \"route\": \"site/page\", "
"\"params\": {...}, \"query\": {...}, \"status\": 302 }. Redirige vers la "
"page interne si le statut n’est pas indiqué."

#: src/Form/SettingsFieldset.php:108
msgid "Check rights to view resource before redirection"
msgstr "Vérifier les droits de voir la ressource avant de rediriger"

#: src/Form/SettingsFieldset.php:138
msgid "Malformed JSON string."
msgstr "Chaîne json malformée."

#: src/Form/SettingsFieldset.php:139
msgid "The JSON must be an object."
msgstr "Le JSON doit être un objet."

#: src/Form/SettingsFieldset.php:198
msgid ""
"JSON must map keys to objects with at least a non-empty \"target\". Routes "
"must be non-empty strings. No redirect loops allowed."
msgstr ""
"Le json doit aliger des clées aux objets avec au moins une \"target\" non-"
"vide. Les routes doivent être des chaînes non-vides. Les redirections "
"multiples sont interdites."

#~ msgid ""
#~ "The advanced redirections are not a valid json. Check quotes, commas, "
#~ "escapes and backslash."
#~ msgstr ""
#~ "Les redirections avancées ne sont pas un json valide. Vérifier les "
#~ "guillemets, les virgules, les échappements et les barres inverses."

#~ msgid "Value is not JSON."
#~ msgstr "La valeur n’est pas json."

#~ msgid ""
#~ "Set the resource id, then the sign \"=\", then a page slug or a url, "
#~ "relative or absolute."
#~ msgstr ""
#~ "Indiquer l'identifiant de la ressource, puis le signe « = », puis la page "
#~ "ou l’url, relative ou absolue."
