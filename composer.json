{
    "name": "daniel-km/omeka-s-module-redirector",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Redirect any resource or route to any page or url, for example to display an item set with a specific page.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "administration",
        "miscellaneous",
        "curation"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Redirector",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Redirector/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2412)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "Redirector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedirectorTest\\": "tests/RedirectorTest/"
        }
    },
    "extra": {
        "installer-name": "Redirector"
    }
}
